__pycache__/
*.py[cod]

# OpenPBS stdout/stderr files written at the checkout root.
/*.o[0-9]*
/*.e[0-9]*

# macOS metadata.
.DS_Store

# Python packaging and tooling caches.
*.egg-info/
build/
dist/
.mypy_cache/
.ruff_cache/
